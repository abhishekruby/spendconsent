# Public HTTPS front for compose.public.yaml. Caddy gets the certificate itself.
# Logs off (access and error): approval-link tokens travel in /api/links/<token> paths.
{
	log {
		output discard
	}
}

{$SPENDCONSENT_PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	handle /api/* {
		reverse_proxy spendconsent:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
