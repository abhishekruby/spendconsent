# Public HTTPS front for compose.public.yaml. Caddy gets the certificate itself.
# No access log: approval-link tokens travel in /api/links/<token> paths.
{$SPENDCONSENT_PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	handle /api/* {
		reverse_proxy spendconsent:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
