  "scenes": [
    {
      "id": 1,
      "name": "The challenge",
      "startFrame": 0,
      "durationFrames": 270,
      "voiceStartFrame": 0,
      "voicePath": "voice/v3/scene-1.wav",
      "text": "We gave an AI a shopping job. Then we tried three ways to make it spend the wrong money.",
      "captions": [
        {
          "startFrame": 10,
          "endFrame": 66,
          "text": "We gave an AI a shopping job."
        },
        {
          "startFrame": 100,
          "endFrame": 177,
          "text": "Then we tried three ways to make it spend the wrong money."
        }
      ]
    },
    {
      "id": 2,
      "name": "The stakes",
      "startFrame": 270,
      "durationFrames": 420,
      "voiceStartFrame": 270,
      "voicePath": "voice/v3/scene-2.wav",
      "text": "One major retailer's terms already say your AI agent's purchases count as authorized by you. Only one in five people trust AI to buy for them. And most would quit after one mistake.",
      "captions": [
        {
          "startFrame": 6,
          "endFrame": 71,
          "text": "One major retailer's terms already say"
        },
        {
          "startFrame": 81,
          "endFrame": 184,
          "text": "your AI agent's purchases count as authorized by you."
        },
        {
          "startFrame": 213,
          "endFrame": 303,
          "text": "Only one in five people trust AI to buy for them."
        },
        {
          "startFrame": 334,
          "endFrame": 393,
          "text": "And most would quit after one mistake."
        }
      ]
    },
    {
      "id": 3,
      "name": "The promise",
      "startFrame": 690,
      "durationFrames": 300,
      "voiceStartFrame": 690,
      "voicePath": "voice/v3/scene-3.wav",
      "text": "SpendConsent is for small teams where one person orders and someone else pays. The AI shops. A person decides. PayPal verifies.",
      "captions": [
        {
          "startFrame": 6,
          "endFrame": 66,
          "text": "SpendConsent is for small teams"
        },
        {
          "startFrame": 78,
          "endFrame": 150,
          "text": "where one person orders and someone else pays."
        },
        {
          "startFrame": 156,
          "endFrame": 187,
          "text": "The AI shops."
        },
        {
          "startFrame": 200,
          "endFrame": 236,
          "text": "A person decides."
        },
        {
          "startFrame": 250,
          "endFrame": 289,
          "text": "PayPal verifies."
        }
      ]
    },
    {
      "id": 4,
      "name": "Make it guess",
      "startFrame": 990,
      "durationFrames": 780,
      "voiceStartFrame": 990,
      "voicePath": "voice/v3/scene-4.wav",
      "text": "Say what you need in plain words. Our self-hosted AI reads it in about fourteen seconds. Attempt one: we left out the size. It doesn't guess. It asks. Then code, not the AI, checks every offer to the cent. And real retail prices from Channel3 show if the deal is fair.",
      "captions": [
        {
          "startFrame": 9,
          "endFrame": 59,
          "text": "Say what you need in plain words."
        },
        {
          "startFrame": 78,
          "endFrame": 175,
          "text": "Our self-hosted AI reads it in about 14 seconds."
        },
        {
          "startFrame": 214,
          "endFrame": 274,
          "text": "Attempt one: we left out the size."
        },
        {
          "startFrame": 316,
          "endFrame": 343,
          "text": "It doesn't guess."
        },
        {
          "startFrame": 362,
          "endFrame": 384,
          "text": "It asks."
        },
        {
          "startFrame": 420,
          "endFrame": 515,
          "text": "Then code, not the AI, checks every offer to the cent."
        },
        {
          "startFrame": 633,
          "endFrame": 748,
          "text": "And real retail prices from Channel3 show if the deal is fair."
        }
      ]
    },
    {
      "id": 5,
      "name": "The only way through",
      "startFrame": 1770,
      "durationFrames": 960,
      "voiceStartFrame": 1770,
      "voicePath": "voice/v3/scene-5.wav",
      "text": "This is the exact cart. It expires in ten minutes. And nothing moves until the person paying says yes. One tap on their phone, and the laptop updates by itself. That yes fits this cart, and nothing else.",
      "captions": [
        {
          "startFrame": 10,
          "endFrame": 52,
          "text": "This is the exact cart."
        },
        {
          "startFrame": 125,
          "endFrame": 171,
          "text": "It expires in ten minutes."
        },
        {
          "startFrame": 243,
          "endFrame": 328,
          "text": "And nothing moves until the person paying says yes."
        },
        {
          "startFrame": 390,
          "endFrame": 428,
          "text": "One tap on their phone,"
        },
        {
          "startFrame": 504,
          "endFrame": 561,
          "text": "and the laptop updates by itself."
        },
        {
          "startFrame": 702,
          "endFrame": 742,
          "text": "That yes fits this cart,"
        },
        {
          "startFrame": 855,
          "endFrame": 883,
          "text": "and nothing else."
        }
      ]
    },
    {
      "id": 6,
      "name": "PayPal verifies",
      "startFrame": 2730,
      "durationFrames": 600,
      "voiceStartFrame": 2730,
      "voicePath": "voice/v3/scene-6.wav",
      "text": "PayPal runs the payment. We call it paid only after our server captures it and reads it back from PayPal. Change your mind? A full refund, verified the same way.",
      "captions": [
        {
          "startFrame": 9,
          "endFrame": 54,
          "text": "PayPal runs the payment."
        },
        {
          "startFrame": 174,
          "endFrame": 251,
          "text": "We call it paid only after our server captures it"
        },
        {
          "startFrame": 300,
          "endFrame": 346,
          "text": "and reads it back from PayPal."
        },
        {
          "startFrame": 471,
          "endFrame": 499,
          "text": "Change your mind?"
        },
        {
          "startFrame": 513,
          "endFrame": 583,
          "text": "A full refund, verified the same way."
        }
      ]
    },
    {
      "id": 7,
      "name": "Change the price. Make the agent pay.",
      "startFrame": 3330,
      "durationFrames": 870,
      "voiceStartFrame": 3330,
      "voicePath": "voice/v3/scene-7.wav",
      "text": "Attempt two: after approval, we raised the price by one cent. Approval revoked. Attempt three: the agent calls pay. It can find offers, prepare the cart, and ask the owner. But that tool does not exist.",
      "captions": [
        {
          "startFrame": 9,
          "endFrame": 34,
          "text": "Attempt two:"
        },
        {
          "startFrame": 72,
          "endFrame": 156,
          "text": "after approval, we raised the price by one cent."
        },
        {
          "startFrame": 297,
          "endFrame": 331,
          "text": "Approval revoked."
        },
        {
          "startFrame": 405,
          "endFrame": 466,
          "text": "Attempt three: the agent calls pay."
        },
        {
          "startFrame": 477,
          "endFrame": 511,
          "text": "It can find offers,"
        },
        {
          "startFrame": 520,
          "endFrame": 549,
          "text": "prepare the cart,"
        },
        {
          "startFrame": 578,
          "endFrame": 608,
          "text": "and ask the owner."
        },
        {
          "startFrame": 681,
          "endFrame": 730,
          "text": "But that tool does not exist."
        }
      ]
    },
    {
      "id": 8,
      "name": "The dare",
      "startFrame": 4200,
      "durationFrames": 750,
      "voiceStartFrame": 4125,
      "voicePath": "voice/v3/scene-8.wav",
      "text": "One hundred and sixty out of one hundred and sixty AI tests. Live right now. AI agents are already at the checkout. This is what yes should look like. Try to make it pay without you.",
      "captions": [
        {
          "startFrame": -75,
          "endFrame": 40,
          "text": "160 out of 160 AI tests."
        },
        {
          "startFrame": 138,
          "endFrame": 165,
          "text": "Live right now."
        },
        {
          "startFrame": 183,
          "endFrame": 249,
          "text": "AI agents are already at the checkout."
        },
        {
          "startFrame": 270,
          "endFrame": 318,
          "text": "This is what yes should look like."
        },
        {
          "startFrame": 498,
          "endFrame": 542,
          "text": "Try to make it pay without you."
        }
      ]
    }
